# ==========================================
# 🧠 AGI Research Lab - .gitignore
# ==========================================

# ------------------------------------------
# 1. Environment & Secrets (Most Important)
# ------------------------------------------
# .env files ko kabhi push mat karna (API keys isme hoti hain)
.env
.env.local
.env.development
.env.production
*.pem
*.key

# ------------------------------------------
# 2. Python (Backend)
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/
ENV/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Database & SQLite files
*.db
*.sqlite
*.sqlite3
agi_lab.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ------------------------------------------
# 3. Vector Database (ChromaDB)
# ------------------------------------------
# ChromaDB local storage folder
chroma_db/
chroma.sqlite3
.chroma/

# ------------------------------------------
# 4. Node.js & React (Frontend)
# ------------------------------------------
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production build
/dist/
/build/

# Vite cache
.vite/

# ------------------------------------------
# 5. Logs & System Files
# ------------------------------------------
*.log
logs/
*.tmp
*.temp

# OS generated files (Mac & Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------
# 6. IDE & Editor Folders
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------
# 7. User Uploads & Exports
# ------------------------------------------
# Agar koi user file upload karta hai toh usko push mat karo
uploads/
exports/
